# ==============================================================================
# OmniRisk Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real secret keys, service role keys, or production credentials.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Public / Safe for Browser Client)
# ------------------------------------------------------------------------------
# [PUBLIC] Supabase Project API URL (Found in: Supabase Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# [PUBLIC] Supabase Anonymous / Client API Key (Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon public)
# Safe for frontend exposure because database access is governed by Postgres Row-Level Security (RLS) policies.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Backend / Administrative Scripts Only - STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# [SERVER-ONLY SECRET] Supabase Service Role Key (Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role)
# WARNING: Bypasses Row-Level Security (RLS). Use ONLY in offline backend migration/seeding scripts. NEVER expose to Vite client code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
